{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "where-money-sleeps",
  "account_id": "76cf12a5975b729026f1b1dd89005e53",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-04-01",
  "routes": [
    {
      "pattern": "money.duypham.me",
      "custom_domain": true
    },
    {
      "pattern": "wms.duypham.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "where-money-sleeps-db",
      "database_id": "35bc919b-28f2-4025-a576-5036f62b886c"
    }
  ]
}
