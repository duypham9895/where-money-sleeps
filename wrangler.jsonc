{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "where-money-sleeps",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "wheremoneysleeps.duyslab.icu",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "where-money-sleeps-db",
      "database_id": "35bc919b-28f2-4025-a576-5036f62b886c"
    }
  ]
}
