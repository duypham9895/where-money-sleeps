# ==============================================================================
# Where Money Sleeps — Cấu hình môi trường cho Pipeline Bước 5 (QĐ 56)
# Sao chép file này thành `.env` (file `.env` đã được .gitignore bảo vệ):
#   cp .env.example .env
# Sau đó kiểm tra kết nối bằng lệnh:
#   python3 -I scripts/wms-media-pipeline.py --check-env
# ==============================================================================

# 1. ElevenLabs API (Video + Audio + Timestamps + Sound Effects)
# Tạo tại: https://elevenlabs.io/app/settings/api-keys
# Bật 5 quyền (scopes):
#   - Image & Video (Flows) : Access (Read/Write) -> gọi POST /v1/flows/video
#   - Text to Speech        : Access              -> gọi POST /v1/text-to-speech/{voice_id}/with-timestamps
#   - Sound Effects         : Access              -> gọi POST /v1/sound-generation
#   - Voices                : Read                -> gọi GET /v1/voices
#   - Pronunciation Dicts   : Read & Write        -> khoá cách đọc CASA, NAPAS, Debit, Credit
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=vi_editorial
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VIDEO_MODEL=veo-3.1-fast-generate-001
WMS_VIDEO_MODE=hybrid

# 2. Kênh YouTube chính thức & YouTube Data API v3 (OAuth 2.0)
# Kênh chính thức đã tạo (2026-11-08): https://www.youtube.com/@WhereMoneySleeps
YOUTUBE_CHANNEL_HANDLE=@WhereMoneySleeps
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@WhereMoneySleeps
YOUTUBE_CLIENT_SECRET_FILE=.secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=.secrets/youtube_token.json
