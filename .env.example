# ==============================================================================
# Where Money Sleeps — Cấu hình môi trường cho Pipeline Bước 5 (QĐ 56)
# Kiến trúc Hybrid:
#   - 5A Audio: ElevenLabs API (Text to Speech with-timestamps + Sound Effects)
#   - 5B Video: Google Veo 3.1 (tận dụng quota Google AI Ultra) + FFmpeg Diorama/TT99 Overlay
#   - 5C Upload: YouTube Data API v3 -> https://www.youtube.com/@WhereMoneySleeps (unlisted)
#   - 5D Embed : Ghi ngược youtubeId 11 ký tự vào docs/prototype.html
#
# Sao chép file này thành `.env` (file `.env` đã được .gitignore bảo vệ):
#   cp .env.example .env
# Kiểm tra kết nối:
#   python3 -I scripts/wms-media-pipeline.py --check-env
# ==============================================================================

# 1. ElevenLabs API (CHỈ phụ trách Audio: Voiceover + Timestamps + Sound Effects)
# Tạo tại: https://elevenlabs.io/app/settings/api-keys
# Chỉ cần bật các quyền Audio (KHÔNG cần tốn credit video của ElevenLabs):
#   - Text to Speech        : Access       -> POST /v1/text-to-speech/{voice_id}/with-timestamps
#   - Sound Effects         : Access       -> POST /v1/sound-generation
#   - Voices                : Read         -> GET /v1/voices
#   - Pronunciation Dicts   : Read & Write -> khoá cách đọc CASA, NAPAS, Debit, Credit
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=vi_editorial
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# 2. Google Veo 3.1 Video Generation (Tận dụng quota Google AI Ultra / Gemini API)
# Lấy key tại: https://aistudio.google.com/apikey (hoặc Vertex AI)
# SDK sử dụng: `google-genai` (`client.models.generate_videos`)
# Hỗ trợ cả 16:9 (YouTube Dài) và 9:16 (YouTube Shorts) + reference_images (Risograph Diorama)
GEMINI_API_KEY=
GOOGLE_VEO_MODEL=veo-3.1-generate-preview
GOOGLE_VEO_FAST_MODEL=veo-3.1-fast-generate-preview
WMS_VIDEO_MODE=veo-hybrid

# 3. Kênh YouTube chính thức & YouTube Data API v3 (OAuth 2.0)
# Kênh chính thức đã tạo (2026-11-08): https://www.youtube.com/@WhereMoneySleeps
YOUTUBE_CHANNEL_HANDLE=@WhereMoneySleeps
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@WhereMoneySleeps
YOUTUBE_CLIENT_SECRET_FILE=.secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=.secrets/youtube_token.json
